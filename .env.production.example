APP_NAME=Lootra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
ADMIN_MFA_REQUIRED=true
APP_URL=https://lootra.example
DEMO_ECONOMY_ENABLED=false
BUSINESS_SIMULATION_MODE=false
DEMO_ONLY_ENVIRONMENT=false
VIRTUAL_CURRENCY_CODE=EUR_DEMO
VIRTUAL_CURRENCY_LABEL="EUR Demo"
DEMO_TREASURY_INITIAL_BALANCE=100000
DEMO_WITHDRAWAL_MINIMUM=1
DEMO_WITHDRAWAL_MAXIMUM=5000
CRASH_MAX_MULTIPLIER=1000

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=database.internal
DB_PORT=3306
DB_DATABASE=calculadora
DB_USERNAME=lootra_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# Incluir únicamente CIDR o direcciones de proxies administrados.
TRUSTED_PROXIES=
TRUSTED_HOSTS=lootra.example
CORS_ALLOWED_ORIGINS=https://lootra.example
REQUIRE_VERIFIED_FOR_PLAY=true
SANCTUM_STATEFUL_DOMAINS=lootra.example
SANCTUM_TOKEN_EXPIRATION=60
DB_SSLMODE=require

REDIS_HOST=redis.internal
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@lootra.example
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_DEBUG=false

RICKYEDIT_CAMPAIGN_ENABLED=false
RICKYEDIT_OFFICIAL_ASSETS_ENABLED=false
RICKYEDIT_INITIAL_BALANCE=1000
RICKYEDIT_DURATION_MINUTES=15
RICKYEDIT_CREATOR_SCORE=1250
RICKYEDIT_START_AT=
RICKYEDIT_END_AT=
RICKYEDIT_YOUTUBE_URL=

DEMO_DEPOSITS_ENABLED=false
DEMO_DEPOSITS_MAX_BALANCE=50000
REGISTRATION_BONUS=1000
PERMISSION_CACHE_STORE=redis
MYSQL_ATTR_SSL_CA=/run/secrets/mysql-ca.pem
