APP_NAME=Lootra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
ADMIN_MFA_REQUIRED=false
APP_URL=http://localhost

# Lootra funciona localmente como simulador; nunca conecta dinero real.
DEMO_ECONOMY_ENABLED=true
BUSINESS_SIMULATION_MODE=false
DEMO_ONLY_ENVIRONMENT=false
VIRTUAL_CURRENCY_CODE=EUR_DEMO
VIRTUAL_CURRENCY_LABEL="EUR Demo"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=
TRUSTED_HOSTS=localhost
CORS_ALLOWED_ORIGINS=
REQUIRE_VERIFIED_FOR_PLAY=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@lootra.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Analytics 4
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_DEBUG=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_EXPIRATION=60

# RickyEdit x Lootra — El Reto de los 1.000
RICKYEDIT_CAMPAIGN_ENABLED=false
RICKYEDIT_OFFICIAL_ASSETS_ENABLED=false
RICKYEDIT_INITIAL_BALANCE=1000
RICKYEDIT_DURATION_MINUTES=15
RICKYEDIT_CREATOR_SCORE=1250
RICKYEDIT_START_AT=
RICKYEDIT_END_AT=
RICKYEDIT_YOUTUBE_URL=

# Funciones exclusivamente demo. Mantener desactivadas en producción.
DEMO_DEPOSITS_ENABLED=false
DEMO_DEPOSITS_MAX_BALANCE=50000
REGISTRATION_BONUS=1000
